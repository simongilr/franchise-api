		{
			"name": "product",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"let jsonData = pm.response.json();",
							"",
							"// Usamos la variable branchId que ya guardaste",
							"let branchId = pm.environment.get(\"branchId\");",
							"",
							"// Buscamos el branch correcto",
							"let branch = jsonData.branches.find(b => b.id == branchId);",
							"",
							"if (branch && branch.products.length > 0) {",
							"    // Tomamos siempre el último producto agregado",
							"    let lastProduct = branch.products[branch.products.length - 1];",
							"    pm.environment.set(\"productId\", lastProduct.id);",
							"    console.log(\"Producto ID guardado:\", lastProduct.id);",
							"} else {",
							"    console.log(\"No hay productos en este branch.\");",
							"}",
							""
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
